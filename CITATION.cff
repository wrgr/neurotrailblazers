    family-names: "Gray-Roncal"
    affiliation: "Johns Hopkins University"
    email: "wgr@jhu.edu"
  - given-names: "Sydney"
    family-names: "Floryanzia"
  - name: "NeuroTrailblazers Team"
    website: "https://neurotrailblazers.org"
url: "https://neurotrailblazers.org"
repository-code: "https://github.com/wrgr/neurotrailblazers"
license:
  - CC-BY-4.0
  - MIT
keywords:
  - connectomics
  - neuroscience education
  - electron microscopy
  - open curriculum
  - BRAIN CONNECTS
identifiers:
