---
layout: null
permalink: /technical-training/journal-club/index-data.json
sitemap: false
---
[{%- for p in site.data.journal_papers.papers -%}
{%- capture publication_key -%}{%- include papers/publication-links-gate.html paper=p -%}{%- endcapture -%}
{%- assign publication_key = publication_key | strip -%}
{%- assign publication_pair = nil -%}
{%- if publication_key != '' -%}{%- assign publication_pair = site.data.paper_publication_links[publication_key] -%}{%- endif -%}
{"id":{{ p.id | jsonify }},"title":{{ p.title | jsonify }},"authors":{{ p.authors | jsonify }},"year":{{ p.year | jsonify }},"journal":{{ p.journal | jsonify }},"doi":{{ p.doi | jsonify }},"publication_links":{{ publication_pair | jsonify }},"dimension":{{ p.dimension | jsonify }},"era":{{ p.inclusion_role | jsonify }},"tier":{{ p.tier | default: 2000 | jsonify }},"kcore":{{ p.k_core | default: 0 | jsonify }},"degree":{{ p.in_degree | plus: p.out_degree | jsonify }},"tags":{{ p.tags | jsonify }},"chunk":{{ forloop.index0 | divided_by: 100 }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}]
